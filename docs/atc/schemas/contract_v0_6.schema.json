{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ATC v0.6 authoring draft contract",
  "type":"object", "additionalProperties":false,
  "required":["contract_version","id","title","language","task_kind","status","goal","scope","priority","decide","authorization","verify","limits","deliverables","lifecycle","review"],
  "properties":{
    "contract_version":{"const":"0.6"},
    "id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "title":{"type":"string","minLength":1},"language":{"type":"string","minLength":1},
    "task_kind":{"enum":["research","decision","writing","workflow"]},
    "status":{"const":"draft"},
    "goal":{"type":"object","additionalProperties":false,"required":["outcome","audience"],"properties":{"outcome":{"type":"string","minLength":1},"audience":{"type":"string","minLength":1}}},
    "scope":{"type":"object","additionalProperties":false,"required":["include","exclude"],"properties":{"include":{"$ref":"#/$defs/actions"},"exclude":{"$ref":"#/$defs/actions"}}},
    "priority":{"type":"object","additionalProperties":false,"required":["order","conflict_policy"],"properties":{"order":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"conflict_policy":{"const":"escalate_if_unspecified"}}},
    "decide":{"type":"object","additionalProperties":false,"required":["method","evidence_policy","on_insufficient_evidence","explain_recommendation"],"properties":{"method":{"enum":["qualitative","quantitative"]},"evidence_policy":{"const":"cite_and_label_uncertainty"},"on_insufficient_evidence":{"const":"abstain"},"explain_recommendation":{"const":true}}},
    "authorization":{"type":"object","additionalProperties":false,"required":["default","actions","approval"],"properties":{"default":{"const":"deny"},"actions":{"type":"object","propertyNames":{"$ref":"#/$defs/action"},"additionalProperties":{"enum":["allow","deny","approval_required"]}},"approval":{"type":"object","additionalProperties":false,"required":["scope","expires_minutes"],"properties":{"scope":{"const":"single_action"},"expires_minutes":{"type":"integer","minimum":1,"maximum":1440}}}}},
    "verify":{"type":"object","additionalProperties":false,"required":["pass_when","checks"],"properties":{"pass_when":{"const":"all"},"checks":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["id","kind","criterion","rule"],"properties":{"id":{"type":"string","minLength":2},"kind":{"enum":["programmatic","human"]},"criterion":{"type":"string","minLength":3},"rule":{"enum":["output_nonempty","manual_review"]}}}}}},
    "limits":{"type":"object","additionalProperties":false,"required":["max_spend_hkd","max_retries_per_step"],"properties":{"max_spend_hkd":{"const":0},"max_retries_per_step":{"type":"integer","minimum":0,"maximum":10}}},
    "deliverables":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","description","required"],"properties":{"id":{"type":"string","minLength":2},"description":{"type":"string","minLength":2},"required":{"type":"boolean"}}}},
    "lifecycle":{"type":"object","additionalProperties":false,"required":["initial_state","terminal_states"],"properties":{"initial_state":{"const":"draft"},"terminal_states":{"type":"array","uniqueItems":true,"items":{"enum":["completed","failed","cancelled"]},"minItems":3,"maxItems":3}}},
    "review":{"type":"object","additionalProperties":false,"required":["open_questions","assumptions","requested_sensitive_actions"],"properties":{"open_questions":{"type":"array","items":{"type":"string"}},"assumptions":{"type":"array","items":{"type":"string"}},"requested_sensitive_actions":{"$ref":"#/$defs/actions"}}}
  },
  "$defs":{"action":{"enum":["research_public","analyze","draft_output","send_external","purchase","deploy","delete_data","modify_external","transfer_funds"]},"actions":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/action"}}}
}
