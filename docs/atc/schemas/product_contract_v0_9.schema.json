{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "atc_version",
    "id",
    "version",
    "product",
    "requirements",
    "policy",
    "acceptance"
  ],
  "properties": {
    "kind": {
      "const": "product_contract"
    },
    "atc_version": {
      "const": "0.9"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "object",
      "required": [
        "name",
        "goal"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "allow_actions",
        "deny_actions",
        "write_roots"
      ],
      "properties": {
        "allow_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_required_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "max_spend_hkd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement_refs",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "requirement_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "method": {
            "enum": [
              "all_work_orders_accepted",
              "human_review"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
