{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "atc_version",
    "id",
    "version",
    "parent",
    "goal",
    "requirement_refs",
    "depends_on",
    "assignment",
    "authorization",
    "workspace",
    "deliverables",
    "acceptance"
  ],
  "properties": {
    "kind": {
      "const": "work_order"
    },
    "atc_version": {
      "const": "0.9"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "parent": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "goal": {
      "type": "string"
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assignment": {
      "type": "object",
      "required": [
        "required_capabilities"
      ],
      "properties": {
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "allow"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": [
        "write_paths"
      ],
      "properties": {
        "write_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "enum": [
              "document",
              "code",
              "dataset",
              "test_result"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "deliverable_refs",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "deliverable_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "method": {
            "enum": [
              "artifact_nonempty",
              "human_review"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
