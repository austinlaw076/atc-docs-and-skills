{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
          },
          "supported": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10000
          }
        },
        "required": [
          "claim_id",
          "supported",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "acceptance_satisfied": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10000
    }
  },
  "required": [
    "request_id",
    "task_id",
    "contract_hash",
    "input_hash",
    "artifact_hash",
    "verdict",
    "checks",
    "acceptance_satisfied",
    "summary"
  ],
  "additionalProperties": false
}
