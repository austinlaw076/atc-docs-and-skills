{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
          },
          "supported": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10000
          }
        },
        "required": [
          "claim_id",
          "supported",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "acceptance_satisfied": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10000
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "satisfied",
          "claim_refs",
          "reason"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
          },
          "satisfied": {
            "type": "boolean"
          },
          "claim_refs": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10000
          }
        }
      }
    }
  },
  "required": [
    "request_id",
    "task_id",
    "contract_hash",
    "input_hash",
    "artifact_hash",
    "verdict",
    "checks",
    "acceptance_satisfied",
    "summary",
    "criteria"
  ],
  "additionalProperties": false
}
